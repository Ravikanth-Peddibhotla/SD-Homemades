# PostgreSQL connection string used by @workspace/db and drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sd_homemades

# Runtime database diagnostics. Query text never includes bound parameter values.
DB_APPLICATION_NAME=sd-homemades-api
DB_QUERY_LOG_LEVEL=error
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_USES=7500
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Separate management database. Do not reuse DATABASE_URL in production.
SUPERADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sd_homemades_management
SUPERADMIN_DB_APPLICATION_NAME=sd-homemades-management
SUPERADMIN_DB_POOL_MAX=5
SUPERADMIN_DB_SSL=false
SUPERADMIN_DB_SSL_REJECT_UNAUTHORIZED=true