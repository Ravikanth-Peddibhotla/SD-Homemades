# Copy an environment-specific template before running the app:
# cp .env.development.example .env
# cp .env.production.example .env

# Customer and management database URLs.
DATABASE_URL=replace-with-environment-database-url
SUPERADMIN_DATABASE_URL=replace-with-environment-management-database-url

# Clerk authentication.
CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
VITE_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
SESSION_SECRET=replace-with-a-long-random-secret

# Runtime database diagnostics.
DB_APPLICATION_NAME=sd-homemades-api
DB_QUERY_LOG_LEVEL=error
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_USES=7500
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Management database diagnostics.
SUPERADMIN_DB_APPLICATION_NAME=sd-homemades-management
SUPERADMIN_DB_POOL_MAX=5
SUPERADMIN_DB_SSL=false
SUPERADMIN_DB_SSL_REJECT_UNAUTHORIZED=true