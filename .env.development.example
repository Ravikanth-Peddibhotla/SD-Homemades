# Local customer database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sd_homemades

# Local management database.
SUPERADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sd_homemades_management

# Optional: add real development Clerk keys in your untracked .env file.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
SESSION_SECRET=replace-with-a-long-random-development-secret

NODE_ENV=development
PORT=8080
BASE_PATH=/
DB_APPLICATION_NAME=sd-homemades-api-dev
DB_QUERY_LOG_LEVEL=debug
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_USES=7500
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
SUPERADMIN_DB_APPLICATION_NAME=sd-homemades-management-dev
SUPERADMIN_DB_POOL_MAX=5
SUPERADMIN_DB_SSL=false
SUPERADMIN_DB_SSL_REJECT_UNAUTHORIZED=false